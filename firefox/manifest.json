{
  "manifest_version": 2,
  "name": "BoomGuard – AI Movie Volume Leveler",
  "short_name": "BoomGuard",
  "version": "2.2.0",
  "description": "Keeps movie dialogue clear and turns down loud action scenes automatically, with on-device AI that learns your taste.",
  "browser_specific_settings": {
    "gecko": {
      "id": "boomguard@khadgachy07.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "page": "background.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "brain.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "BoomGuard"
  },
  "commands": {
    "too-loud": {
      "suggested_key": {
        "default": "Alt+Shift+Down"
      },
      "description": "Too loud – turn this kind of scene down and remember it"
    },
    "too-quiet": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "Too quiet – turn this kind of scene up and remember it"
    }
  },
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
}
