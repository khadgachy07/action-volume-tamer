{
  "manifest_version": 3,
  "name": "Action Volume Tamer",
  "version": "2.0.0",
  "description": "On-device AI keeps movie dialogue audible, turns down loud action scenes, and learns how you like it.",
  "permissions": ["tabCapture", "offscreen", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Action Volume Tamer"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "too-loud": {
      "suggested_key": { "default": "Alt+Shift+Down" },
      "description": "Too loud – turn this kind of scene down and remember it"
    },
    "too-quiet": {
      "suggested_key": { "default": "Alt+Shift+Up" },
      "description": "Too quiet – turn this kind of scene up and remember it"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
